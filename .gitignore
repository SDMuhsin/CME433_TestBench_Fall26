# =====================================================================
# GanAccelAsic root .gitignore
# Only hand-written sources, configs, scripts, small golden data and
# human-facing docs are tracked. Everything regenerable, third-party or
# personal stays on disk untracked. See README.md "Not in this repository".
# =====================================================================

# ---- Agent hand-over notes (local only, see llmdocs/README.md) ------
llmdocs/
C[L]AUDE.md
.c[l]aude/

# ---- Local data / build outputs (repo-relative, regenerable) --------
/data/
/build/
build/
**/runs/
**/runs_archive/
**/logs/
obj_dir/
sim_build/
result
result-*

# ---- Python / tool caches & environments -----------------------------
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/
.cvc/

# ---- Simulation dumps & compiled sims --------------------------------
*.vcd
*.fst
*.vpd
*.saif
*.fsdb
*.vvp
sim/results/
results.xml

