(DELAYFILE (SDFVERSION "3.0") (DESIGN "tb_selftest") (DIVIDER .) (TIMESCALE 1ns)
 (CELL (CELLTYPE "tb_selftest") (INSTANCE)
  (DELAY (ABSOLUTE
   (INTERCONNECT cb.Y f1.CLK (0.050:0.050:0.050) (0.050:0.050:0.050))
   (INTERCONNECT cb.Y f2.CLK (0.050:0.050:0.050) (0.050:0.050:0.050))
   (INTERCONNECT cb.Y m.CLK (0.130:0.130:0.130) (0.130:0.130:0.130))
   (INTERCONNECT a m.A[0] (0.011:0.011:0.011) (0.011:0.011:0.011))
   (INTERCONNECT a m.A[1] (0.012:0.012:0.012) (0.012:0.012:0.012))
   (INTERCONNECT a m.A[2] (0.013:0.013:0.013) (0.013:0.013:0.013))
   (INTERCONNECT a m.A[3] (0.014:0.014:0.014) (0.014:0.014:0.014))
   (INTERCONNECT a m.A[4] (0.015:0.015:0.015) (0.015:0.015:0.015))
   (INTERCONNECT a m.A[5] (0.016:0.016:0.016) (0.016:0.016:0.016))
   (INTERCONNECT a m.A[6] (0.017:0.017:0.017) (0.017:0.017:0.017))
   (INTERCONNECT a m.A[7] (0.018:0.018:0.018) (0.018:0.018:0.018)))))
 (CELL (CELLTYPE "gf180mcu_as_sc_mcu7t3v3__clkbuff_4") (INSTANCE cb)
  (DELAY (ABSOLUTE (IOPATH A Y (0.200:0.200:0.200) (0.200:0.200:0.200)))))
 (CELL (CELLTYPE "gf180mcu_as_sc_mcu7t3v3__dfxtp_2") (INSTANCE f1)
  (DELAY (ABSOLUTE (IOPATH CLK Q (0.448:0.448:0.448) (0.430:0.430:0.430))))
  (TIMINGCHECK
   (SETUP (posedge D) (posedge CLK) (0.200:0.200:0.200))
   (SETUP (negedge D) (posedge CLK) (0.100:0.100:0.100))
   (HOLD (posedge D) (posedge CLK) (-0.300:-0.300:-0.300))
   (HOLD (negedge D) (posedge CLK) (-0.300:-0.300:-0.300))))
 (CELL (CELLTYPE "gf180mcu_as_sc_mcu7t3v3__dfsrtp_2") (INSTANCE f2)
  (DELAY (ABSOLUTE (IOPATH CLK Q (0.448:0.448:0.448) (0.430:0.430:0.430)))))
 (CELL (CELLTYPE "gf180mcu_ocd_ip_sram__sram256x8m8wm1") (INSTANCE m)
  (DELAY (ABSOLUTE
   (COND CEN== 1'b0 && GWEN== 1'b1 (IOPATH CLK Q[1] (6.780:6.780:6.780) (6.780:6.780:6.780))))))
)
